@startuml
!theme plain
skinparam defaultFontSize 12
skinparam stateBackgroundColor #LightBlue
skinparam stateBorderColor #DarkBlue

title nemo - State Diagram (Status)

' ===== ChatViewModel State Machine =====
state ChatViewModelState {
    [*] --> Idle : init()

    state Idle {
        [*] --> Ready : loadMessages()完了
        Ready : messageText: String
        Ready : messages: [Conversation]
        Ready : isLoading = false
        Ready : errorMessage = nil
    }

    state Loading {
        state Validating <<entryPoint>> {
            Validating : 入力チェック
            Validating : - messageText.isEmpty
            Validating : - selectedModelId.isEmpty
        }

        state Sending <<exitPoint>> {
            Sending : isLoading = true
            Sending : SwiftDataに保存
        }

        state AwaitingResponse {
            AwaitingResponse : API通信中
            AwaitingResponse : async/await
        }
    }

    state Success {
        [*] --> ResponseReceived
        ResponseReceived : isLoading = false
        ResponseReceived : assistantメッセージ追加
    }

    state Error {
        state ValidationError {
            ValidationError : errorMessage = "モデル未選択"
        }

        state NetworkError {
            NetworkError : errorMessage = "通信エラー"
        }

        state NoInputError {
            NoInputError : errorMessage = nil
            NoInputError : (早期return)
        }
    }
}

' ===== Transitions =====
Ready --> Validating : sendMessage()呼び出し

Validating --> NoInputError : [messageText.isEmpty]
Validating --> ValidationError : [selectedModelId.isEmpty]
Validating --> Sending : [入力OK]

Sending --> AwaitingResponse : Task開始
AwaitingResponse --> ResponseReceived : API成功
AwaitingResponse --> NetworkError : API失敗/例外

ResponseReceived --> Ready : 状態リセット
NoInputError --> Ready : (即座に戻る)
ValidationError --> Ready : エラークリア
NetworkError --> Ready : エラークリア/再試行

' ===== SettingsViewModel State Machine =====
state SettingsViewModelState {
    [*] --> SettingsIdle : init() / loadSettings()

    state SettingsIdle {
        SettingsIdle : apiKey: String
        SettingsIdle : customPrompt: String
        SettingsIdle : models: []
        SettingsIdle : isLoading = false
    }

    state FetchingModels {
        FetchingModels : isLoading = true
        FetchingModels : APIキー検証
    }

    state ModelsLoaded {
        ModelsLoaded : models: [Model]
        ModelsLoaded : isLoading = false
    }

    state ModelSelected {
        ModelSelected : selectedModelId: String
        ModelSelected : 
    }

    state SettingsError {
        SettingsError : errorMessage: String
        SettingsError : isLoading = false
    }
}

' ===== Settings Transitions =====
SettingsIdle --> FetchingModels : fetchModels()
SettingsIdle --> SettingsError : [apiKey.isEmpty]

FetchingModels --> ModelsLoaded : API成功
FetchingModels --> SettingsError : API失敗

ModelsLoaded --> ModelSelected : selectModel()
ModelSelected --> SettingsIdle : (状態継続)

SettingsError --> SettingsIdle : エラークリア

' ===== ConversationListViewModel State Machine =====
state ConversationListViewModelState {
    [*] --> ListIdle : init()

    state ListIdle {
        ListIdle : selectedConversationId: UUID?
        ListIdle : columnVisibility: .all
        ListIdle : showingSettings: false
    }

    state ConversationSelected {
        ConversationSelected : selectedConversationId: UUID
    }

    state CreatingConversation {
        CreatingConversation : 新規UUID生成
        CreatingConversation : selectedConversationId更新
    }

    state DeletingConversation {
        DeletingConversation : SwiftDataから削除
        DeletingConversation : selectedConversationIdクリア
    }

    state SettingsPresented {
        SettingsPresented : showingSettings = true
    }
}

' ===== List Transitions =====
ListIdle --> ConversationSelected : 会話タップ
ListIdle --> CreatingConversation : 新規ボタン押下
ListIdle --> DeletingConversation : 削除スワイプ/コンテキストメニュー
ListIdle --> SettingsPresented : 設定ボタン押下

CreatingConversation --> ConversationSelected : (自動遷移)
DeletingConversation --> ListIdle : 削除完了
SettingsPresented --> ListIdle : sheet閉じる

note right of ChatViewModelState
  主要トリガー:
  - onAppear: loadMessages()
  - 
  - onChange: UI状態更新
  
  @Publishedプロパティ:
  - messageText, messages
  - isLoading, errorMessage
end note

note right of SettingsViewModelState
  UserDefaults連携:
  - openrouter_api_key
  - custom_prompt
  - selected_model_id
end note

note bottom of ConversationListViewModelState
  NavigationSplitView連携:
  - columnVisibility制御
  - selectedConversationIdで
    detail表示切り替え
end note

@enduml
