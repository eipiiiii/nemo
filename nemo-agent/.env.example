# OpenAI API Key (if using OpenAI directly)
OPENAI_API_KEY=sk-...

# OpenRouter API Key (if using OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...

# Model configuration
DEFAULT_MODEL=openai/gpt-4

# Agent configuration
MAX_ITERATIONS=10
TIMEOUT_SECONDS=300

# Database
CHECKPOINT_DB_PATH=./agent_state.db
