# nemo-agent/.env.example
#
# このファイルは「手動でサーバーを起動する場合」のみ必要です。
# nemo macOS アプリから起動する場合は不要です。
# (APIキーはSwift側のKeychainから自動的に注入されます)
#
# 使い方:
#   cp .env.example .env
#   .env を編集してAPIキーを設定

# OpenRouter API Key (https://openrouter.ai/)
# nemo の Settings 画面で設定したキーと同じもの
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI を直接使う場合 (OpenRouterがあれば不要)
# OPENAI_API_KEY=sk-...

# Model configuration (optional)
# DEFAULT_MODEL=openai/gpt-4

# Agent configuration (optional)
# MAX_ITERATIONS=10
# TIMEOUT_SECONDS=300

# Database (optional)
# CHECKPOINT_DB_PATH=./agent_state.db
